BACKUP_COLLECTION=bigquery_export_errors
BIGQUERY_PROJECT_ID=fitness-tracker-39bca
COLLECTION_PATH=users/{uid}/weight_entries
DATABASE=(default)
DATABASE_REGION=nam5
DATASET_ID=logmaxxing_raw
DATASET_LOCATION=us
EXCLUDE_OLD_DATA=yes
firebaseextensions.v1beta.function/location=us-central1
LOG_LEVEL=warn
MAX_DISPATCHES_PER_SECOND=100
MAX_ENQUEUE_ATTEMPTS=3
TABLE_ID=weight_entries
TABLE_PARTITIONING=DAY
TIME_PARTITIONING_FIELD_TYPE=omit
USE_NEW_SNAPSHOT_QUERY_SYNTAX=yes
VIEW_TYPE=view
WILDCARD_IDS=true
